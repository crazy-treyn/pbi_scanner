query T
SELECT description
FROM duckdb_functions()
WHERE function_name = 'dax_query';
----
Runs a DAX statement against a Power BI semantic model or a direct XMLA endpoint and returns the result rows as a table. connection_string and dax_text are positional; named options use :=.

query T
SELECT examples[1]
FROM duckdb_functions()
WHERE function_name = 'dax_query';
----
SELECT * FROM dax_query('Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;', 'EVALUATE ROW("probe_ok", 1)');

query T
SELECT parameters::VARCHAR
FROM duckdb_functions()
WHERE function_name = 'dax_query';
----
[connection_string, dax_text, auth_mode, access_token, secret_name, tenant_id, client_id, client_secret, effective_user_name, timeout_ms, schema_probe_rows, normalize_dax_column_names]

query T
SELECT description
FROM duckdb_functions()
WHERE function_name IN ('pbi_columns', 'pbi_measures', 'pbi_relationships', 'pbi_tables')
ORDER BY function_name;
----
Returns the columns in a Power BI semantic model by running EVALUATE INFO.VIEW.COLUMNS(). connection_string is positional; named options use :=.
Returns the measures in a Power BI semantic model by running EVALUATE INFO.VIEW.MEASURES(). connection_string is positional; named options use :=.
Returns the relationships in a Power BI semantic model by running EVALUATE INFO.VIEW.RELATIONSHIPS(). connection_string is positional; named options use :=.
Returns the tables in a Power BI semantic model by running EVALUATE INFO.VIEW.TABLES(). connection_string is positional; named options use :=.

query T
SELECT examples[1]
FROM duckdb_functions()
WHERE function_name IN ('pbi_columns', 'pbi_measures', 'pbi_relationships', 'pbi_tables')
ORDER BY function_name;
----
SELECT * FROM pbi_columns('Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;');
SELECT * FROM pbi_measures('Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;');
SELECT * FROM pbi_relationships('Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;');
SELECT * FROM pbi_tables('Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;');

query T
SELECT parameters::VARCHAR
FROM duckdb_functions()
WHERE function_name IN ('pbi_columns', 'pbi_measures', 'pbi_relationships', 'pbi_tables')
ORDER BY function_name;
----
[connection_string, auth_mode, access_token, secret_name, tenant_id, client_id, client_secret, effective_user_name, timeout_ms, schema_probe_rows, normalize_dax_column_names]
[connection_string, auth_mode, access_token, secret_name, tenant_id, client_id, client_secret, effective_user_name, timeout_ms, schema_probe_rows, normalize_dax_column_names]
[connection_string, auth_mode, access_token, secret_name, tenant_id, client_id, client_secret, effective_user_name, timeout_ms, schema_probe_rows, normalize_dax_column_names]
[connection_string, auth_mode, access_token, secret_name, tenant_id, client_id, client_secret, effective_user_name, timeout_ms, schema_probe_rows, normalize_dax_column_names]

query I
SELECT count(*)
FROM duckdb_functions()
WHERE function_name IN ('dax_query', 'pbi_tables', 'pbi_columns', 'pbi_measures', 'pbi_relationships')
  AND categories = ['powerbi']
  AND len(examples) = 1;
----
5

statement error
SELECT *
FROM dax_query(
    'Initial Catalog=example_semantic_model;',
    'EVALUATE ROW("x", 1)'
);
----
Data Source is required

statement error
SELECT *
FROM dax_query(
    '',
    'EVALUATE ROW("x", 1)'
);
----
connection_string is required

statement error
SELECT *
FROM dax_query(
    'Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;',
    'EVALUATE ROW("x", 1)'
);
----
Initial Catalog is required

statement error
SELECT *
FROM dax_query(
    'Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;',
    ''
);
----
dax_text is required

statement error
SELECT *
FROM dax_query(
    'Data Source=https://example.com/xmla?vs=sobe_wowvirtualserver&db=example_db;Initial Catalog=sobe_wowvirtualserver-example_db;',
    'EVALUATE ROW("x", 1)',
    access_token := 'dummy',
    timeout_ms := 0
);
----
timeout_ms must be greater than zero

statement error
SELECT *
FROM dax_query(
    'Data Source=https://example.com/xmla?vs=sobe_wowvirtualserver&db=example_db;Initial Catalog=sobe_wowvirtualserver-example_db;',
    'EVALUATE ROW("x", 1)',
    access_token := 'dummy',
    schema_probe_rows := -1
);
----
schema_probe_rows must be zero or greater

statement error
SELECT *
FROM dax_query(
    'Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;',
    'EVALUATE ROW("x", 1)',
    secret_name := ''
);
----
secret_name must not be empty

statement error
SELECT *
FROM dax_query(
    'Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;Secret=one;',
    'EVALUATE ROW("x", 1)',
    secret_name := 'two'
);
----
secret_name named parameter conflicts with Secret in the connection string

statement error
SELECT *
FROM dax_query(
    'Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;',
    'EVALUATE ROW("x", 1)'
);
----
access_token named parameter or PBI_XMLA_ACCESS_TOKEN environment variable is required

statement ok
SET pbi_scanner_auth_mode='azure_cli';

statement error
SELECT *
FROM dax_query(
    'Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;',
    'EVALUATE ROW("x", 1)',
    auth_mode := 'unsupported_mode'
);
----
unsupported auth_mode "unsupported_mode"

statement ok
SET pbi_scanner_auth_mode='';

statement error
SET pbi_scanner_auth_mode='unsupported_mode';
----
unsupported auth_mode "unsupported_mode"

statement error
SELECT *
FROM dax_query(
    'Data Source=https://example.com/xmla?vs=sobe_wowvirtualserver&db=example_db;Initial Catalog=sobe_wowvirtualserver-example_db;',
    'EVALUATE ROW("x", 1)'
);
----
access_token named parameter or PBI_XMLA_ACCESS_TOKEN environment variable is required
