query T
SELECT description
FROM duckdb_functions()
WHERE function_name = 'dax_query';
----
Runs a DAX statement against a Power BI semantic model or a direct XMLA endpoint and returns the result rows as a table. connection_string and dax_text are positional; named options use :=.

query T
SELECT examples[1]
FROM duckdb_functions()
WHERE function_name = 'dax_query';
----
SELECT * FROM dax_query('Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;', 'EVALUATE ROW("probe_ok", 1)');

query II
SELECT len(parameters), len(parameter_types)
FROM duckdb_functions()
WHERE function_name = 'dax_query';
----
12	12

query T
SELECT description
FROM duckdb_functions()
WHERE function_name IN ('pbi_columns', 'pbi_measures', 'pbi_relationships', 'pbi_tables')
ORDER BY function_name;
----
Returns the columns in a Power BI semantic model by running EVALUATE INFO.VIEW.COLUMNS(). connection_string is positional; named options use :=.
Returns the measures in a Power BI semantic model by running EVALUATE INFO.VIEW.MEASURES(). connection_string is positional; named options use :=.
Returns the relationships in a Power BI semantic model by running EVALUATE INFO.VIEW.RELATIONSHIPS(). connection_string is positional; named options use :=.
Returns the tables in a Power BI semantic model by running EVALUATE INFO.VIEW.TABLES(). connection_string is positional; named options use :=.

query T
SELECT examples[1]
FROM duckdb_functions()
WHERE function_name IN ('pbi_columns', 'pbi_measures', 'pbi_relationships', 'pbi_tables')
ORDER BY function_name;
----
SELECT * FROM pbi_columns('Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;');
SELECT * FROM pbi_measures('Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;');
SELECT * FROM pbi_relationships('Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;');
SELECT * FROM pbi_tables('Data Source=powerbi://api.powerbi.com/v1.0/myorg/Example%20Workspace;Initial Catalog=example_semantic_model;');

query II
SELECT len(parameters), len(parameter_types)
FROM duckdb_functions()
WHERE function_name IN ('pbi_columns', 'pbi_measures', 'pbi_relationships', 'pbi_tables')
ORDER BY function_name;
----
11	11
11	11
11	11
11	11

# Names follow unordered_map iteration on v1.5.6 and WithTypedKwargs order on DuckDB main.
# Assert the pairs, sorted, so either order passes.
query TTT
SELECT function_name, name, type
FROM (
    SELECT function_name, unnest(parameters) AS name, unnest(parameter_types) AS type
    FROM duckdb_functions()
    WHERE function_name IN ('dax_query', 'pbi_columns', 'pbi_measures', 'pbi_relationships', 'pbi_tables')
)
ORDER BY function_name, name;
----
dax_query	access_token	VARCHAR
dax_query	auth_mode	VARCHAR
dax_query	client_id	VARCHAR
dax_query	client_secret	VARCHAR
dax_query	connection_string	VARCHAR
dax_query	dax_text	VARCHAR
dax_query	effective_user_name	VARCHAR
dax_query	normalize_dax_column_names	BOOLEAN
